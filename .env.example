# ==============================================================================
# CODEFLOW AI — Environment Configuration Example (Phases 1–4)
# Copy this file to `.env.local` (frontend) or `.env` (backend) as needed.
# NEVER commit real API keys or `.env` / `.env.local` files to Git.
# ==============================================================================

# Frontend -> FastAPI Backend URL
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# FastAPI Server Binding
CODEFLOW_BACKEND_HOST=127.0.0.1
CODEFLOW_BACKEND_PORT=8000
CODEFLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Python Execution Sandbox Mode ("auto" | "docker" | "development_subprocess")
CODEFLOW_EXECUTION_MODE=auto
CODEFLOW_DEFAULT_TIMEOUT=3.0
CODEFLOW_MAX_TIMEOUT=8.0
CODEFLOW_DEFAULT_MAX_STEPS=500
CODEFLOW_HARD_MAX_STEPS=1500

# ==============================================================================
# PHASE 4 — AI TUTOR PROVIDER CONFIGURATION (Server-Side Only)
# ==============================================================================

# Primary Provider: "gemini" (default) | "openai"
CODEFLOW_AI_DEFAULT_PROVIDER=gemini

# 1. Google Gemini Configuration (Primary Provider)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# 2. OpenAI Configuration (Alternative Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE_URL=https://api.openai.com/v1

# AI Tutor Safety, Context & Rate Limits
CODEFLOW_AI_TIMEOUT_SECONDS=25.0
CODEFLOW_AI_MAX_CONTEXT_CHARS=18000
CODEFLOW_AI_RATE_LIMIT_PER_MINUTE=30
CODEFLOW_TUTOR_DB_PATH=backend/.data/tutor_conversations.db

